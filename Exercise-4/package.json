{
  "name": "personal-finance-tracker-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal Finance Tracker API built with Node.js, Express, and Neon PostgreSQL",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node Back-end/server.js",
    "server": "nodemon --watch Back-end --ext js,json Back-end/server.js",
    "cliente": "npm run dev --prefix Front-end",
    "dev": "concurrently \"npm run server\" \"npm run cliente\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.9"
  }
}
